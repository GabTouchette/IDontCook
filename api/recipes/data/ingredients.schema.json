{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Canonical Ingredient",
  "type": "object",
  "additionalProperties": false,
  "required": ["canonical_name_en", "category"],
  "properties": {
    "canonical_name_en": {"type": "string"},
    "canonical_name_fr": {"type": ["string", "null"]},
    "category": {
      "type": "string",
      "description": "2-letter category code",
      "enum": [
        "PR",  
        "MS",  
        "DE",  
        "BA",  
        "CJ",  
        "DG",  
        "BK",  
        "SP",  
        "CO",  
        "FR",  
        "BE",  
        "HO"   
      ]
    }
  }
}
